{
  "name": "superfarm-frontend",
  "version": "1.0.0",
  "description": "超级农场主 H5游戏前端",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:run": "vitest run",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore"
  },
  "dependencies": {
    "vue": "^3.3.8",
    "pinia": "^2.1.7",
    "vue-router": "^4.2.5",
    "animate.css": "^4.1.1",
    "axios": "^1.6.2"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.5.0",
    "vite": "^5.0.0",
    "vue-tsc": "^1.8.22",
    "typescript": "^5.2.2",
    "@types/node": "^20.8.10",
    "sass": "^1.69.5",
    "eslint": "^8.53.0",
    "@typescript-eslint/parser": "^6.10.0",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "eslint-plugin-vue": "^9.18.1",
    "vitest": "^1.0.4",
    "@vitest/ui": "^1.0.4",
    "@vue/test-utils": "^2.4.3",
    "jsdom": "^23.0.1",
    "@vitest/coverage-v8": "^1.0.4",
    "happy-dom": "^12.10.3"
  }
} 