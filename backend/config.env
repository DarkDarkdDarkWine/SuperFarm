# 超级农场主游戏后端配置文件
# ====================================

# DeepSeek API配置
# 获取地址: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-9a9625a853574a6eb7b0373e7e47e09f
DEEPSEEK_API_URL=https://api.deepseek.com

# 服务器配置
# 开发环境: development | 生产环境: production
NODE_ENV=development
PORT=3001
HOST=localhost

# 跨域配置
# 前端应用的URL地址，用于CORS设置
FRONTEND_URL=http://localhost:3000

# 日志配置
LOG_LEVEL=debug
LOG_DIR=logs

# AI配置
# AI决策缓存时间(秒)
AI_CACHE_TTL=300
# AI API超时时间(毫秒) 
AI_TIMEOUT=10000
# AI重试次数
AI_RETRY_COUNT=3

# 游戏配置
GAME_MAX_PLAYERS=4
GAME_TIMEOUT=300000

# 限流配置
# 每15分钟最多请求次数
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# 安全配置
# JWT密钥(生产环境请修改为随机字符串)
JWT_SECRET=superfarm_jwt_secret_key_2024

# 数据库配置(如果需要)
# DATABASE_URL=mongodb://localhost:27017/superfarm

# Redis配置(如果需要缓存)
# REDIS_URL=redis://localhost:6379 